FROM python:3.14-slim

# Install uv, minimal build tools, Node.js for Pyright, and PostgreSQL 18 client tools.
# pg_dump must be at least as new as the PostgreSQL server it dumps.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg gcc nodejs python3-dev && \
    install -d /usr/share/postgresql-common/pgdg && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc && \
    . /etc/os-release && \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client-18 && \
    rm -rf /var/lib/apt/lists/* && \
    pip install uv --no-cache-dir

# Pre-install project dependencies into /opt/openclaw-venv
# This path is NOT under /workspace so it survives the volume mount.
WORKDIR /tmp/setup
COPY pyproject.toml uv.lock ./

# Minimal stub so uv sync does not complain about a missing package source
RUN mkdir -p backend && touch backend/__init__.py

# Sync all deps (including dev) directly into the runtime venv and warm
# Pyright before JSON checks. Do not move a venv after creation: console
# scripts can keep absolute shebangs pointing at the original path.
RUN UV_PROJECT_ENVIRONMENT=/opt/openclaw-venv uv sync --frozen && \
    /opt/openclaw-venv/bin/pyright --version >/dev/null && \
    rm -rf /tmp/setup

ENV VIRTUAL_ENV=/opt/openclaw-venv
ENV PATH=/usr/lib/postgresql/18/bin:/opt/openclaw-venv/bin:$PATH
# Project source arrives via volume mount at runtime
ENV PYTHONPATH=/workspace
# The Vibe sandbox is an integration environment. E2E tests still self-skip
# when required services, corpora, or local gateway credentials are unavailable.
ENV QUIMERA_E2E=true

WORKDIR /workspace
