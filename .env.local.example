# Local-only QUIMERA runtime example.
# Copy to .env.local and adjust locally. Do not commit real secrets.

LITELLM_MASTER_KEY=quimera-dev-key-change-me
QUIMERA_LLM_API_KEY=${LITELLM_MASTER_KEY}

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

QUIMERA_OLLAMA_EMBED_MODEL=nomic-embed-text:latest
QUIMERA_OLLAMA_CHAT_MODEL=qwen3:14b
QUIMERA_OLLAMA_WARMUP_TIMEOUT_SECONDS=120
