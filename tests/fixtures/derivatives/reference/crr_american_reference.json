{
  "metadata": {
    "schema_version": "1.0.0",
    "gerado_por": "Claude, revisor do Marco 2A; não é o implementador de binomial.py",
    "modelo": "árvore recombinante de Cox, Ross e Rubinstein com rendimento contínuo q",
    "o_que_e": "preço exato da árvore finita de N passos, europeia e americana",
    "o_que_nao_e": "não é o preço do modelo contínuo; o erro de discretização da árvore não aparece aqui",
    "formulas": {
      "dt": "T_years / steps",
      "up": "exp(sigma * sqrt(dt))",
      "down": "exp(-sigma * sqrt(dt))",
      "prob_up": "(exp((r_cont - q) * dt) - down) / (up - down)",
      "discount": "exp(-r_cont * dt)",
      "no": "S * exp((altas - baixas) * sigma * sqrt(dt)), uma exponencial por nó",
      "americana": "max(continuação, intrínseco) em todo nó antes do vencimento, inclusive na raiz"
    },
    "metodo": "indução retroativa por níveis em decimal.Decimal, arredondamento ROUND_HALF_EVEN; exp e sqrt do módulo decimal são corretamente arredondadas",
    "precisao_de_trabalho_digitos": 60,
    "precisao_de_conferencia_digitos": 90,
    "digitos_significativos_publicados": 20,
    "conferencia": "cada resultado publicado é idêntico, nos 20 dígitos, quando a conta inteira é refeita com 90 dígitos",
    "conferencia_da_europeia": "a europeia da indução coincide, nos 20 dígitos, com a soma binomial fechada de N + 1 termos",
    "politica_de_entrada": "S, K, r_cont, q, sigma e T_years são o repr do binário de 64 bits; a conta parte do valor exato desse binário, de modo que float(texto) reproduz a entrada da produção",
    "unidades": "taxas contínuas anuais em decimal; preços por unidade do ativo",
    "ancora_publicada": {
      "caso": "grupo hull, 5 passos",
      "fonte": "Hull, Risk Management and Financial Institutions, apêndice F",
      "valores_impressos": {
